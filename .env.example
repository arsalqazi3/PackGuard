# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Inside docker compose the host is "db", for example
# postgresql://USER:PASSWORD@db:5432/DBNAME
# Leave empty to run the gateway without a database.
DATABASE_URL=
PYPI_SIMPLE_URL=
WARN_THRESHOLD=
BLOCK_THRESHOLD=
# How long a PyPI lookup is cached in the packages table (hours, default 24).
PACKAGE_CACHE_TTL_HOURS=
GEMINI_API_KEY=
GROQ_API_KEY=
